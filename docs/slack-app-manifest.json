{
  "display_information": {
    "name": "jaypost",
    "description": "Questions and notifications from your agents and scripts"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "jaypost",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/jaypost",
        "description": "Open requests, history, mute and quiet hours",
        "usage_hint": "pending | cancel | history [count] | mute [duration] | unmute | quiet [hours]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "commands", "files:write", "im:history", "im:write", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.im"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
