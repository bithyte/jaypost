{
  "name": "jaypost",
  "version": "0.9.0",
  "description": "Local HTTP API that asks you a question on Telegram, Discord or Slack with buttons and returns your answer",
  "author": { "name": "Cozmin" },
  "repository": "https://github.com/bithyte/jaypost",
  "license": "Apache-2.0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" hook",
            "timeout": 360
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" hook",
            "asyncRewake": true,
            "timeout": 3720
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" hook",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin\" hook"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "jaypost": { "command": "${CLAUDE_PLUGIN_ROOT}/bin/jaypost-plugin", "args": ["mcp"] }
  }
}
