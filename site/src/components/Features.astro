---
const features = [
  {
    title: 'Buttons or text replies',
    text: 'Answer with a tap, or type a reply when the question needs words.',
    href: 'https://github.com/bithyte/jaypost#ask-a-question',
  },
  {
    title: 'Background questions',
    text: 'Send a question and collect the answer later, with no connection held open.',
    href: 'https://github.com/bithyte/jaypost#background-questions',
  },
  {
    title: 'Notifications',
    text: 'Messages that need no answer, like a finished backup. They clean themselves up.',
    href: 'https://github.com/bithyte/jaypost#send-a-notification',
  },
  {
    title: 'Attachments',
    text: 'Send a diff or a log along with the question, so you can see it before you approve.',
    href: 'https://github.com/bithyte/jaypost#attachments',
  },
  {
    title: 'Quiet hours',
    text: 'Notifications go out silently at night. Approvals still ping.',
    href: 'https://github.com/bithyte/jaypost#quiet-hours',
  },
  {
    title: 'Question log',
    text: 'Every question and how it ended: answered, timed out, cancelled or still open.',
    href: 'https://github.com/bithyte/jaypost#question-log',
  },
]
---

<section class="section" id="features">
  <div class="wrap">
    <div class="section-head">
      <h2>What it does</h2>
    </div>
    <div class="features">
      {
        features.map((feature) => (
          <a class="card" href={feature.href}>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
