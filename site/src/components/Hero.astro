---
import RoundTrip from './RoundTrip.astro'
import Tabs from './Tabs.astro'
import { SNIPPETS } from '../snippets/index.ts'
---

<section class="hero">
  <div class="wrap">
    <h1>Your agent asks.<br />Your phone buzzes.</h1>
    <p class="subhead">
      Let your agents and scripts ask you before they act. You tap a button in{' '}
      <span class="flip"
        ><span class="visually-hidden">Telegram or Discord</span><span
          class="flip-words"
          aria-hidden="true"
          ><span class="flip-telegram">Telegram</span><span class="flip-discord">Discord</span></span
        ></span
      >, and they carry on.
    </p>
    <RoundTrip />
    <div class="install">
      <Tabs
        id="install"
        prompt
        tabs={[
          { label: 'npx', code: SNIPPETS.npxInit },
          { label: 'linux', code: SNIPPETS.binaryLinux },
          { label: 'macos', code: SNIPPETS.binaryMacos },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 64px 0 80px;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 4rem);
    font-weight: 700;
  }

  .subhead {
    max-width: 52ch;
    margin: 20px auto 0;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* Sized to the longer word so the sentence doesn't reflow; reduced motion keeps Telegram. */
  .flip-words {
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
  }

  .flip-words > span {
    grid-area: 1 / 1;
    font-weight: 600;
  }

  .flip-telegram {
    color: var(--telegram);
  }

  .flip-discord {
    color: var(--discord);
    visibility: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flip-words > span {
      animation: flip-roll 6s infinite;
    }

    /* start part-way in so Telegram is already showing on load */
    .flip-words > .flip-telegram {
      animation-delay: -0.3s;
    }

    .flip-words > .flip-discord {
      visibility: visible;
      animation-delay: -3.3s;
    }
  }

  @keyframes flip-roll {
    0% {
      opacity: 0;
      transform: translateY(100%);
    }
    5%,
    45% {
      opacity: 1;
      transform: translateY(0);
    }
    50%,
    100% {
      opacity: 0;
      transform: translateY(-100%);
    }
  }

  .install {
    max-width: 680px;
    margin: 0 auto;
    text-align: left;
  }
</style>
