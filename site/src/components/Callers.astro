---
import Tabs from './Tabs.astro'
import { SNIPPETS } from '../snippets/index.ts'
---

<section class="section" id="callers">
  <div class="wrap">
    <div class="section-head">
      <h2>Works from anything</h2>
      <p>
        The same question from an MCP client, the shell, curl, Node or a Claude Code hook. See{' '}
        <a href="https://github.com/bithyte/jaypost/blob/main/docs/mcp.md">Agents</a>,{' '}
        <a href="https://github.com/bithyte/jaypost/blob/main/docs/claude-code.md">the hook</a> and{' '}
        <a href="https://github.com/bithyte/jaypost/blob/main/docs/http-api.md">the HTTP API</a> in the docs.
      </p>
    </div>
    <Tabs
      id="callers"
      tabs={[
        { label: 'MCP', code: SNIPPETS.mcpAdd },
        { label: 'shell', code: SNIPPETS.shellSend },
        { label: 'curl', code: SNIPPETS.curlRequest },
        { label: 'Node', code: SNIPPETS.nodeClient },
        { label: 'Claude Code hook', code: SNIPPETS.hookSettings },
      ]}
    />
  </div>
</section>
