---
type Props = { code: string; prompt?: boolean; copy?: boolean }

const { code, prompt = false, copy = true } = Astro.props
---

<div class:list={['code', { prompt, 'no-copy': !copy }]}>
  <pre tabindex="0"><code>{code}</code></pre>
  {copy && <button class="copy" type="button" aria-label="Copy to clipboard">copy</button>}
</div>

<script>
  const RESET_MS = 1500

  function selectText(element: Element): void {
    const selection = window.getSelection()
    if (!selection) {
      return
    }
    const range = document.createRange()
    range.selectNodeContents(element)
    selection.removeAllRanges()
    selection.addRange(range)
  }

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.copy')
    const code = button?.parentElement?.querySelector('code')
    if (!button || !code) {
      return
    }
    try {
      await navigator.clipboard.writeText(code.textContent ?? '')
    } catch {
      // clipboard API missing or denied: leave the text selected so Ctrl+C works
      selectText(code)
      return
    }
    button.textContent = 'copied'
    button.dataset.state = 'copied'
    setTimeout(() => {
      button.textContent = 'copy'
      delete button.dataset.state
    }, RESET_MS)
  })
</script>
