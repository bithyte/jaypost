{
  "name": "jaypost",
  "version": "0.10.0",
  "description": "Local HTTP API that asks you a question on Telegram or Discord with buttons and returns your answer",
  "keywords": [
    "approval",
    "bot",
    "discord",
    "human-in-the-loop",
    "telegram"
  ],
  "license": "Apache-2.0",
  "author": "Cozmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bithyte/jaypost.git",
    "directory": "apps/cli"
  },
  "bin": {
    "jaypost": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "install.sh"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc -p ../../tsconfig.build.json && vp pack",
    "build:exe": "node scripts/build-exe.ts",
    "openapi": "node scripts/openapi.ts",
    "copy-root-files": "cp ../../README.md ../../LICENSE ../../install.sh .",
    "prepack": "vp run copy-root-files && vp run build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@discordjs/core": "catalog:",
    "@discordjs/rest": "catalog:",
    "@discordjs/ws": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "commander": "catalog:",
    "fastify": "catalog:",
    "grammy": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jaypost/client": "workspace:*",
    "@jaypost/core": "workspace:*",
    "@jaypost/hook": "workspace:*",
    "@jaypost/install": "workspace:*",
    "@jaypost/mcp": "workspace:*",
    "@jaypost/protocol": "workspace:*",
    "@jaypost/providers": "workspace:*",
    "@jaypost/service": "workspace:*",
    "@jaypost/store": "workspace:*",
    "@jaypost/testing": "workspace:*",
    "punycode": "^2.3.1"
  },
  "engines": {
    "node": ">=24.15"
  }
}
