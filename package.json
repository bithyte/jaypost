{
  "name": "jaypost-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter jaypost dev",
    "start": "node apps/cli/src/cli.ts service run",
    "cli": "node apps/cli/src/cli.ts",
    "test": "vp test",
    "check": "vp check",
    "build": "vp run --filter jaypost build",
    "build:exe": "vp run --filter jaypost build:exe",
    "openapi": "vp run --filter jaypost openapi",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-version.ts && vp install --lockfile-only && vp run openapi",
    "web:dev": "vp run --filter jaypost-site dev",
    "web:build": "vp run --filter jaypost-site build",
    "web:preview": "vp run --filter jaypost-site preview"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@jaypost/install": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@12.14.0"
}
