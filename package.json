{
  "name": "jaypost",
  "version": "0.7.0",
  "description": "Local HTTP API that asks you a question on Telegram or Discord with buttons and returns your answer",
  "keywords": [
    "approval",
    "bot",
    "discord",
    "human-in-the-loop",
    "telegram"
  ],
  "license": "Apache-2.0",
  "author": "Cozmin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bithyte/jaypost.git"
  },
  "bin": {
    "jaypost": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "install.sh"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "cli": "node src/cli.ts",
    "test": "vp test",
    "check": "vp check",
    "build": "tsc -p tsconfig.build.json && vp pack",
    "build:exe": "node scripts/build-exe.ts",
    "openapi": "node scripts/openapi.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && vp install --lockfile-only && vp run openapi",
    "prepack": "vp run build",
    "web:dev": "vp run --filter jaypost-site dev",
    "web:build": "vp run --filter jaypost-site build",
    "web:preview": "vp run --filter jaypost-site preview"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "24.19.2",
    "punycode": "^2.3.1",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=24.2"
  },
  "packageManager": "pnpm@12.14.0"
}
